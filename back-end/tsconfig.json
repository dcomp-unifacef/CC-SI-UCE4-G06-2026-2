{
 "compilerOptions": {
   "module": "ESNext",
   "moduleResolution": "bundler",
   "target": "ES2023",
   "rootDir": "./src",
   "outDir": "./dist",
   "strict": true,
   "esModuleInterop": true,
   "forceConsistentCasingInFileNames": true,
   "skipLibCheck": true
 },
 "include": ["src/**/*.ts"],
 "exclude": ["node_modules", "dist", "tests"]
}
