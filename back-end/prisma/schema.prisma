generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Cliente {
  idCliente        Int           @id @default(autoincrement()) @map("id_cliente")
  razaoSocialNome  String        @map("razao_social_nome") @db.VarChar(150)
  cnpjCpf          String?       @unique @map("cnpj_cpf") @db.VarChar(20)
  telefoneWhatsapp String        @map("telefone_whatsapp") @db.VarChar(20)
  email            String?       @db.VarChar(100)
  ramoAtuacao      String?       @map("ramo_atuacao") @db.VarChar(100)
  origemContato    String        @default("Site") @map("origem_contato") @db.VarChar(50)
  observacoes      String?       @db.Text
  criadoEm         DateTime      @default(now()) @map("criado_em")
  compromissos     Compromisso[]

  @@map("cliente")
}

model Administrador {
  idAdministrador Int           @id @default(autoincrement()) @map("id_administrador")
  username        String        @unique @db.VarChar(50)
  senhaHash       String        @map("senha_hash") @db.VarChar(255)
  criadoEm        DateTime      @default(now()) @map("criado_em")
  compromissos    Compromisso[]

  @@map("administrador")
}

model CategoriaCompromisso {
  idCategoria   Int           @id @default(autoincrement()) @map("id_categoria")
  nomeCategoria String        @unique @map("nome_categoria") @db.VarChar(50)
  corHex        String        @default("#D9D9D9") @map("cor_hex") @db.VarChar(7)
  compromissos  Compromisso[]

  @@map("categoria_compromisso")
}

model Compromisso {
  idCompromisso      Int                   @id @default(autoincrement())
  titulo             String
  descricao          String?
  data               DateTime
  horarioInicio      String
  horarioFim         String?
  pregao             String?
  statusCompromisso  String                @default("Pendente")
  antecedenciaAlerta Int                   @default(1)
  idCategoria        Int?                  @map("id_categoria")
  categoria          CategoriaCompromisso? @relation(fields: [idCategoria], references: [idCategoria], onDelete: Restrict)
  idCliente          Int?                  @map("id_cliente")
  cliente            Cliente?              @relation(fields: [idCliente], references: [idCliente], onDelete: SetNull)
  idAdministrador    Int                   @map("id_administrador")
  administrador      Administrador         @relation(fields: [idAdministrador], references: [idAdministrador], onDelete: Restrict)

  @@map("compromissos")
}
